<svg
  width="0"
  height="0"
  aria-hidden="true"
  style="position: absolute;"
>
  <defs>
    <filter
      id="clockerite-liquid-refract"
      x="-20%"
      y="-20%"
      width="140%"
      height="140%"
      color-interpolation-filters="sRGB"
    >
      <!-- Soft surface blur -->
      <feGaussianBlur
        in="SourceGraphic"
        stdDeviation="0.35"
        result="blurred"
      />

      <!-- Organic glass distortion -->
      <feTurbulence
        type="fractalNoise"
        baseFrequency="0.018 0.014"
        numOctaves="2"
        seed="17"
        result="noise"
      />

      <!-- Subtle refraction -->
      <feDisplacementMap
        in="blurred"
        in2="noise"
        scale="7"
        xChannelSelector="R"
        yChannelSelector="G"
        result="refracted"
      />

      <!-- Slightly increase vibrancy -->
      <feColorMatrix
        in="refracted"
        type="saturate"
        values="1.12"
        result="vibrant"
      />

      <feComposite
        in="vibrant"
        in2="SourceGraphic"
        operator="over"
      />
    </filter>
  </defs>
</svg>

<script>
  import "./liquid.ts";
</script>