---
const currentYear = new Date().getFullYear();

const footerLinks = [
  { href: "/portfolio/", label: "Portfolio" },
  { href: "/blog/", label: "Blog" },
  { href: "/shop/", label: "Shop" },
  { href: "/projects/", label: "Projects" },
  { href: "/about/", label: "About" },
];

const legalLinks = [
  { href: "/privacy/", label: "Privacy" },
  { href: "/cookies/", label: "Cookies" },
  { href: "/terms/", label: "Terms" },
];
---

<footer class="border-t border-border">
  <div class="mx-auto max-w-6xl px-6 py-12">
    <div class="grid gap-10 md:grid-cols-3">
      <div>
        <a href="/" class="text-lg font-semibold text-text-primary">Clockerite</a>
        <p class="mt-3 max-w-xs text-sm text-text-secondary">
          Development, projects, creations, and whatever comes next.
        </p>
      </div>

      <div class="flex flex-col gap-2">
        {
          footerLinks.map((link) => (
            <a
              href={link.href}
              class="text-sm text-text-secondary transition-colors hover:text-text-primary"
            >
              {link.label}
            </a>
          ))
        }
      </div>

      <div class="flex flex-col gap-2 text-sm text-text-muted md:items-end">
        <p>© {currentYear} Clockerite</p>
        <div class="flex gap-4">
          {
            legalLinks.map((link) => (
              <a href={link.href} class="transition-colors hover:text-text-primary">
                {link.label}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</footer>
